# Copy to .env (never commit .env). All variables are optional.

# Override the data directory (database, logs). Default: the OS user-data directory.
# ANALISIS_ACCIONES_HOME=C:\Users\me\AnalisisAccionesData

# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# ANALISIS_ACCIONES_LOG_LEVEL=INFO

# Future providers' API keys are stored in the OS keychain (Windows Credential Manager).
# Environment variables named here are only a fallback, e.g.:
# ANALISIS_ACCIONES_TWELVEDATA_API_KEY=
